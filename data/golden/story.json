  "scenes": [
   {
    "id": 0,
    "summary": "Ember the little dragon plays on a sunny hill, but worries about the night.",
    "mood": "warm, then a little worried",
    "lines": [
     {
      "character": "narrator",
      "text": "On a quiet hill, there lived a little dragon called Ember.",
      "focus": "ember",
      "keyword": "Ember"
     },
     {
      "character": "ember",
      "text": "Ember loved the sun, the warm grass, and the big blue sky."
     },
     {
      "character": "narrator",
      "text": "But every night, when the sun went down, Ember felt afraid.",
      "focus": "sun",
      "keyword": "down"
     },
     {
      "character": "ember",
      "text": "What if the dark is full of scary things?"
     }
    ]
   },
   {
    "id": 1,
    "summary": "Night falls in the forest. Ember hides, hears a rustle, and meets Glim the firefly.",
    "mood": "scary, then surprised",
    "lines": [
     {
      "character": "narrator",
      "text": "Then the lights went out, and the forest turned dark."
     },
     {
      "character": "ember",
      "text": "Who is there? I can hear something rustling!",
      "focus": "bush",
      "keyword": "rustling"
     },
     {
      "character": "narrator",
      "text": "A tiny light blinked on, then off, then on again."
     },
     {
      "character": "glim",
      "text": "Hello! I am Glim the firefly, and I glow!",
      "focus": "glim",
      "keyword": "glow"
     }
    ]
   },
   {
    "id": 2,
    "summary": "Glim shows Ember the stars in the meadow.",
    "mood": "curious, delighted",
    "lines": [
     {
      "character": "narrator",
      "text": "Glim floated close, and the dark did not feel so big."
     },
     {
      "character": "glim",
      "text": "Look up, Ember. The dark is where the stars come out to play."
     },
     {
      "character": "ember",
      "text": "Oh! They are sparkling, just like you!",
      "focus": "star_a",
      "keyword": "sparkling"
     },
     {
      "character": "narrator",
      "text": "One by one, Ember counted the stars, and smiled."
     }
    ]
   },
   {
    "id": 3,
    "summary": "Back in the cozy cave, Ember falls asleep while Glim glows nearby.",
    "mood": "sleepy, safe, warm",
    "lines": [
     {
      "character": "narrator",
      "text": "Back home in the cozy cave, Ember curled up in bed."
     },
     {
      "character": "glim",
      "text": "Goodnight, Ember. I will glow right here, by your side."
     },
     {
      "character": "ember",
      "text": "Goodnight, Glim. The dark is not so scary now."
     },
     {
      "character": "narrator",
      "text": "And the little dragon fell fast asleep, under a sky full of friends.",
      "focus": "ember",
      "keyword": "asleep"
     }
    ]
   }
  ]
 },
