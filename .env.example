# ---- Secrets (server only; never NEXT_PUBLIC_) ----
ANTHROPIC_API_KEY=
JEV_API_KEY=                            # direct TypeSafe AI key (console.typesafe.ai/keys); Jev is called directly, no AI Gateway
ELEVENLABS_API_KEY=

# ---- Models ----
STORY_MODEL=claude-sonnet-5-5
STAGING_MODEL=claude-sonnet-5-5
JEV_MODEL=jev-1.14.0                    # pinned direct model id (jev-latest can move)
AGENT_FLOOR=0.40

# ---- Voice ----
VOICE_PROVIDER=eleven                   # draft | eleven (no key -> draft automatically)
VOICE_MODE=ensemble                     # ensemble | locked
WORDS_PER_SECOND=2.35                   # measured on real ElevenLabs v3 takes
CACHE_VERSION=1
INK_MODE=mono                           # mono | chalk

# ---- Time limits (you control these) ----
MAX_STORY_SECONDS=120                   # whole video (speech + page turns + THE END)
TARGET_SECONDS=90                       # aim; must be <= MAX_STORY_SECONDS
MAX_GENERATION_SECONDS=45               # longest wait for page 1 before offering the golden story
MAX_SESSION_MINUTES=30                  # per browser session; generation stops after this
MAX_STORIES_PER_SESSION=6

# ---- Spend guards (daily, all users; 0 = no cap) ----
MAX_DAILY_CLAUDE_TOKENS=0              # 0 = no cap
MAX_DAILY_ELEVEN_CHARS=0               # 0 = no cap

# ---- Dev switches (keep 0 in production; a missing key also falls back to mock/draft) ----
MOCK_CLAUDE=0
MOCK_JEV=0
MOCK_AUDIO=0

DAILY_STORY_RUNS=6
